diff --git a/src/i2pd/Makefile.linux b/src/i2pd/Makefile.linux
index 2c9d7996..5ee9caf4 100644
--- a/src/i2pd/Makefile.linux
+++ b/src/i2pd/Makefile.linux
@@ -14,7 +14,7 @@ CXXVER := $(shell $(CXX) -dumpversion)
 ifneq ($(findstring clang,$(CXX)),)
        NEEDED_CXXFLAGS += -std=c++20
 ifeq ($(TORRENTS),yes)
-       LDLIBS = -lboost_json -lboost_url
+       LDLIBS_BOOST = -lboost_json -lboost_url
 endif
 else ifeq ($(shell expr match ${CXXVER} "11"),2) # gcc 11
        NEEDED_CXXFLAGS += -std=c++20
@@ -22,13 +22,13 @@ else ifeq ($(shell expr match ${CXXVER} "12"),2) # gcc 12
        NEEDED_CXXFLAGS += -std=c++20
 ifeq ($(TORRENTS),yes)
 # assume boost >= 1.81
-       LDLIBS = -lboost_json -lboost_url
+       LDLIBS_BOOST = -lboost_json -lboost_url
 endif
 else ifeq ($(shell expr match ${CXXVER} "1[3-9]"),2) # gcc 13+
        NEEDED_CXXFLAGS += -std=c++23
 ifeq ($(TORRENTS),yes)
 # assume boost >= 1.81
-       LDLIBS = -lboost_json -lboost_url
+       LDLIBS_BOOST = -lboost_json -lboost_url
 endif
 else # not supported
 $(error Compiler too old)
@@ -54,7 +54,7 @@ ifeq ($(USE_UPNP),yes)
 endif
        LDLIBS += -lpthread -ldl
 else
-       LDLIBS += -lssl -lcrypto -lz -lboost_program_options -lpthread -latomic
+       LDLIBS += -L/app/lib -lssl -lcrypto -lz -lboost_program_options $(LDLIBS_BOOST) -lpthread -latomic
 ifeq ($(USE_UPNP),yes)
        LDLIBS += -lminiupnpc
 endif
